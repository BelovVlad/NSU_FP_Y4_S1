# Принцип: исключаем служебные файлы, кэши и локальные настройки.
# Храним исходники, рисунки, литературу, итоговые PDF и PDF отдельных частей.
# docs/search-index/*.json — часть сайта, поэтому тоже хранится в Git.
# Новое имя конспекта (например, ФиХАиМ_Лекции.pdf) не делает его временным.

# ============================================================
# Локальное извлечение ресурсов Rain World и инструменты
# Сайт использует Karma/ и Overseer/, а не папки извлечения.
# ============================================================

/overseer-extracted/
/karma-extracted/
/overseer-render-kit.zip
/karma-render-kit.zip
/tools/

# Старый звук открытия отключён и не загружается сайтом.
/Karma/audio/UIArp.wav

# ============================================================
# Зависимости, кэши и отчёты локальной разработки
# Исходники, tests/ и .github/ нужны для сборки и проверки сайта.
# ============================================================

node_modules/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.gradle/
/android-app/local.properties
/playwright-report/
/test-results/
*.tsbuildinfo

# ============================================================
# Editor / OS
# ============================================================

.vscode/
.idea/

.DS_Store
Thumbs.db
Desktop.ini

*~
*.swp
*.swo


