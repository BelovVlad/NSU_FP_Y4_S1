\@writefile{toc}{\contentsline {section}{\numberline {1}Классический и квантовый газ}{3}{section.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces  Сравнение классического и квантового газа. В классическом пределе размер волнового пакета частицы $\Delta x$ значительно меньше среднего расстояния между частицами $\Delta l$, тогда как в квантовом газе $\Delta x \sim \Delta l$ и волновые пакеты перекрываются. }}{4}{figure.1.1}\protected@file@percent }
\newlabel{fig:classical_quantum_gas}{{1.1}{4}{Сравнение классического и квантового газа. В классическом пределе размер волнового пакета частицы $\Delta x$ значительно меньше среднего расстояния между частицами $\Delta l$, тогда как в квантовом газе $\Delta x \sim \Delta l$ и волновые пакеты перекрываются}{figure.1.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Статистические ансамбли}{4}{section.1.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{Микроканоническое распределение}{4}{subsection*.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces  Изолированная система в микроканоническом ансамбле. Энергия $E$ и объём $V$ фиксированы, а теплоизолированные стенки исключают обмен энергией с окружающей средой. }}{5}{figure.1.2}\protected@file@percent }
\newlabel{fig:microcanonical_system}{{1.2}{5}{Изолированная система в микроканоническом ансамбле. Энергия $E$ и объём $V$ фиксированы, а теплоизолированные стенки исключают обмен энергией с окружающей средой}{figure.1.2}{}}
\@writefile{toc}{\contentsline {subsection}{Каноническое распределение}{6}{subsection*.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces  Канонический ансамбль. Малая система с фиксированными $N$ и $V$ находится в тепловом контакте с термостатом, поддерживающим постоянную температуру $T$. Между системой и термостатом возможен обмен энергией. }}{6}{figure.1.3}\protected@file@percent }
\newlabel{fig:canonical_ensemble}{{1.3}{6}{Канонический ансамбль. Малая система с фиксированными $N$ и $V$ находится в тепловом контакте с термостатом, поддерживающим постоянную температуру $T$. Между системой и термостатом возможен обмен энергией}{figure.1.3}{}}
\@writefile{toc}{\contentsline {subsection}{Большое каноническое распределение}{8}{subsection*.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces  Большой канонический ансамбль. Система находится в контакте с большим резервуаром, поддерживающим постоянные температуру $T$ и химический потенциал $\mu $. Между системой и резервуаром возможен обмен как энергией, так и частицами. }}{8}{figure.1.4}\protected@file@percent }
\newlabel{fig:grand_canonical_ensemble}{{1.4}{8}{Большой канонический ансамбль. Система находится в контакте с большим резервуаром, поддерживающим постоянные температуру $T$ и химический потенциал $\mu $. Между системой и резервуаром возможен обмен как энергией, так и частицами}{figure.1.4}{}}
